# Frontend API base URL. Leave blank to use local mock services.
VITE_API_BASE_URL=

# Keep mock mode enabled unless the corresponding backend integration is available.
VITE_USE_MOCKS=true

# Gemini browser configuration. VITE values are public in a built frontend; never use production secrets here.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Public Supabase project configuration only. Never use a service-role key in VITE variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Algorand / bank-side public configuration. No signing credentials belong in frontend env files.
VITE_ALGORAND_NETWORK=testnet
VITE_ALGORAND_NODE_URL=
VITE_ALGORAND_APP_ID=

# Existing onboarding API switch. Keep false until backend endpoints are available.
VITE_USE_ONBOARDING_API=false
